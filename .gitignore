# Secrets — NEVER commit
.env
*.pem
*.key

# newsagg — user-specific config (watchlists); example is tracked
newsagg/config.yaml
# newsagg — saved login session (contains auth tokens; never commit)
**/sa_auth.json
**/sa_profile/
**/sa_cookies.json

# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_meta

# Models (large binary files — use git-lfs or model registry)
models/artifacts/
*.txt.lgb
*.pkl

# Data (never commit raw data)
data/
*.parquet
*.csv
*.json.gz

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test / coverage
.coverage
htmlcov/
.pytest_cache/

# newsagg dashboard (React app) — build locally
newsagg/dashboard/node_modules/
newsagg/dashboard/dist/
newsagg/web/dashboard/
newsagg/dashboard/tsconfig.tsbuildinfo
