# Copy to `.env` (repo root) and fill in. NEVER commit .env.

# SeekingAlpha login cookie — enables paywalled full-text scraping.
# Get it from your browser devtools (Network tab -> any SA request -> Cookie
# header) while logged into your paid account. Paste the whole Cookie string.
SA_COOKIE=

# YouTube Data API v3 key — for Schwab channel video titles/descriptions.
# Create at https://console.cloud.google.com/ -> enable "YouTube Data API v3".
YOUTUBE_API_KEY=
